# Laravel API base URL (server-side only - the browser never calls it directly).
# With Herd: `cd backend && herd link precious-api` -> http://precious-api.test
API_BASE_URL=http://precious-api.test/api/v1

# Public app name shown in the UI (placeholder until branding is final).
NEXT_PUBLIC_APP_NAME="Precious Hotel & Bar"

# Name of the httpOnly cookie holding the API token.
SESSION_COOKIE_NAME=hp_session

APP_NAME="Precious Hotel & Bar API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://precious-api.test
APP_TIMEZONE=Africa/Lagos

# The Next.js app. Used for CORS and for links in emails (password reset etc.)
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=precious
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120

# Live updates for the bar screens (Laravel Reverb). Run `php artisan reverb:start`.
# Use BROADCAST_CONNECTION=log if you are not running Reverb - screens then refresh every few seconds.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=precious-local
REVERB_APP_KEY=precious-local-key
REVERB_APP_SECRET=change-me-local-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
FILESYSTEM_DISK=local
MEDIA_DISK=public
DOCUMENTS_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# Redis (optional locally, recommended in production)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail - locally "log" writes emails (incl. 2FA codes) to storage/logs/laravel.log.
# Production: MAIL_MAILER=resend and set RESEND_API_KEY.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

# Cloudflare R2 (S3-compatible). Public bucket for hotel/room/product images,
# private bucket for guest ID documents, receipts and reports.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_BUCKET=precious-public
R2_PUBLIC_URL=
R2_PRIVATE_BUCKET=precious-private

# Sanctum token lifetimes (minutes)
SANCTUM_CUSTOMER_TOKEN_TTL=10080
SANCTUM_STAFF_TOKEN_TTL=720

# Two-factor authentication (email OTP)
TWO_FACTOR_CODE_TTL=10
TWO_FACTOR_MAX_ATTEMPTS=5

# First super administrator (created by `php artisan db:seed`).
# The password must be changed on first login.
SUPER_ADMIN_NAME="System Administrator"
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=

# Payment gateway keys are NOT configured here. An administrator enters them
# in Staff > Settings > Payment Gateways; they are stored encrypted with APP_KEY.
